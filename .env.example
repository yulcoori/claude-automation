# ---------------------------------------------------------------------------
# 네이버 검색광고 API  (키워드 검색량 / 경쟁도)
#   발급: https://searchad.naver.com  →  도구 > API 사용 관리
#   무료. 광고를 집행하지 않아도 계정만 만들면 발급됩니다.
# ---------------------------------------------------------------------------
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# 네이버 오픈API  (블로그 검색 → 상위 노출 글 역분석)
#   발급: https://developers.naver.com/apps/#/register
#   사용 API 로 "검색" 을 선택하세요. 무료, 일 25,000회.
# ---------------------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Claude API  (본문 초안 생성)
#   발급: https://console.anthropic.com
#   없어도 됩니다. 없으면 초안 대신 '복붙용 프롬프트'가 생성됩니다.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
