# ===== 필수 설정 =====

# 데이터베이스 (SQLite 파일 경로 - 기본값 그대로 사용 가능)
DATABASE_URL="file:./dev.db"

# 세션 암호화 키 (반드시 변경! 아래 명령으로 생성: openssl rand -base64 32)
NEXTAUTH_SECRET="change-me-please-generate-a-random-secret"

# 배포된 사이트 주소 (로컬 개발 시 http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# ===== 카카오 로그인 (developers.kakao.com 에서 발급) =====
# 1. https://developers.kakao.com > 내 애플리케이션 > 애플리케이션 추가
# 2. [앱 설정 > 플랫폼] Web 플랫폼 등록: 사이트 도메인 입력 (예: https://mycenter.com)
# 3. [제품 설정 > 카카오 로그인] 활성화, Redirect URI 등록:
#    {사이트주소}/api/auth/callback/kakao  (예: https://mycenter.com/api/auth/callback/kakao)
# 4. [앱 설정 > 앱 키] REST API 키 -> KAKAO_CLIENT_ID
# 5. [제품 설정 > 카카오 로그인 > 보안] Client Secret 생성 -> KAKAO_CLIENT_SECRET
# 설정하지 않으면 카카오 로그인 버튼 없이 전화번호 로그인만 표시됩니다.
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# ===== 카카오 알림톡 (선택 / Solapi 연동) =====
# 30회차 완료 시 회원에게 카톡(알림톡)을 발송합니다. 설정하지 않으면 발송 없이 앱 내 알림만 동작.
# 1. business.kakao.com 에서 카카오 비즈니스 채널 개설
# 2. solapi.com 가입 → 카카오 채널 연동 → 발신번호 등록
# 3. 알림톡 템플릿 등록·승인 (예: "#{이름}님, #{회차}회차 수업을 모두 완료하셨습니다! ...")
# 4. 아래 값 입력
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
ALIMTALK_PF_ID=""
ALIMTALK_SENDER_PHONE=""
ALIMTALK_TEMPLATE_COMPLETE=""

# ===== 선택 설정 =====

# 앱에 표시되는 센터 이름
NEXT_PUBLIC_APP_NAME="필라테스 케어"

# 업로드 파일 저장 폴더 (기본값: 프로젝트 폴더 내 uploads)
# UPLOAD_DIR="/data/uploads"

# 최초 관리자 계정 (db:seed 실행 시 생성됨)
ADMIN_PHONE="01000000000"
ADMIN_PASSWORD="admin1234!"
ADMIN_NAME="원장님"
